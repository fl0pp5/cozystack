#!/usr/bin/env bats
# The platform chart checks the image override table against
# packages/core/platform/files/images.yaml, the references the release
# renders. In this proof of concept the file is generated by
# hack/image-list.sh and committed, so a chart change that moves a reference
# has to regenerate it, or the checks run against a release that no longer
# exists.

load test_helper

REPO_ROOT="$(cd "$(dirname "${BATS_TEST_FILENAME:-$0}")/.." && pwd)"

@test "images.yaml is what hack/image-list.sh writes" {
  "$REPO_ROOT/hack/image-list.sh" > "$BATS_TEST_TMPDIR/images.yaml"
  if ! diff -u "$REPO_ROOT/packages/core/platform/files/images.yaml" "$BATS_TEST_TMPDIR/images.yaml" >&2; then
    echo "regenerate it: hack/image-list.sh > packages/core/platform/files/images.yaml" >&2
    false
  fi
}
